#!/bin/sh
# Permit reviewed task commits while protecting secrets and branch isolation.
set -eu

REPO_ROOT=$(git rev-parse --show-toplevel)
BRANCH=$(git branch --show-current)
GOVERNANCE="$REPO_ROOT/.governance"
MESSAGE_CHECKER="$REPO_ROOT/.githooks/message_structure.py"
SECRET_SCANNER="$REPO_ROOT/.githooks/secret_scan.py"
COMMIT_CHECKS="$GOVERNANCE/commit_checks.py"
COMMIT_REVIEW="$GOVERNANCE/commit_review.py"
PYTHON=${PYTHON:-}

if [ -z "$PYTHON" ]; then
    for candidate in "python3" "python" "py -3"; do
        if $candidate -c "import sys" >/dev/null 2>&1; then
            PYTHON=$candidate
            break
        fi
    done
fi
if [ -z "$PYTHON" ]; then
    echo "pre-commit: Python is required for governance checks" >&2
    exit 1
fi

if [ -z "$BRANCH" ]; then
    echo "pre-commit: detached HEAD is not a task branch" >&2
    exit 1
fi
if [ "$BRANCH" = "main" ]; then
    echo "pre-commit: protected branch '$BRANCH' cannot receive task commits" >&2
    exit 1
fi
if [ ! -f "$MESSAGE_CHECKER" ]; then
    echo "pre-commit: message checker is missing" >&2
    exit 1
fi
PYTHONDONTWRITEBYTECODE=1 "$PYTHON" "$MESSAGE_CHECKER" branch "$BRANCH"

if [ ! -f "$COMMIT_CHECKS" ]; then
    echo "pre-commit: deterministic commit checks are missing" >&2
    exit 1
fi
PYTHONDONTWRITEBYTECODE=1 "$PYTHON" "$COMMIT_CHECKS"

if [ ! -f "$SECRET_SCANNER" ]; then
    echo "pre-commit: staged secret scanner is missing" >&2
    exit 1
fi
PYTHONDONTWRITEBYTECODE=1 "$PYTHON" "$SECRET_SCANNER"

# Scan secrets before any future external semantic reviewer receives the diff.
if [ ! -f "$COMMIT_REVIEW" ]; then
    echo "pre-commit: semantic commit reviewer is missing" >&2
    exit 1
fi
PYTHONDONTWRITEBYTECODE=1 "$PYTHON" "$COMMIT_REVIEW"
